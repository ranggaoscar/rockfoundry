# Rock Foundry production runtime variables (RF-002D).
# Provision on the VPS as /opt/rockfoundry/config/runtime.env (root:root, mode 600).
# NEVER commit real values. NEVER print them into logs, chat or Git.
#
# --- Owner Google OAuth (identity allowlist, default deny) ---
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
#   Authorized JavaScript origin : https://foundry.rockbase.web.id
#   Authorized redirect URI      : https://foundry.rockbase.web.id/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=https://foundry.rockbase.web.id
# 32+ random bytes, e.g. head -c 48 /dev/urandom | base64 | tr -d '\n'
NEXTAUTH_SECRET=
# Comma-separated owner identities. Default deny: any identity not listed is refused.
ROCKFOUNDRY_OWNER_EMAILS=ranggaoscar@gmail.com
# Optional hard binding to the immutable Google subject id (recommended).
# Read it once from https://www.googleapis.com/oauth2/v3/userinfo with the owner account.
# ROCKFOUNDRY_OWNER_GOOGLE_SUBS=

# --- Rock Foundry application ---
ROCKFOUNDRY_WORK_ORIGIN=https://foundry.rockbase.web.id
ROCKFOUNDRY_DATA_DIR=/opt/rockfoundry/data
ROCKFOUNDRY_DATABASE_URL=file:/opt/rockfoundry/data/rockfoundry.db

# --- Hermes execution (server-side only; injected from the protected Hermes env file) ---
HERMES_EXECUTOR_ENABLED=true
HERMES_EXECUTOR_PRIVATE_HTTP_ORIGIN=http://192.168.16.1:8643
# HERMES_RUNS_BASE_URL / HERMES_MODEL / HERMES_API_KEY come from
# /opt/hermes-agent/home/profiles/rockfoundry/client.env (owner-provisioned, never copied).
