generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  canonicalState String   @default("{}")
  version        Int      @default(1)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages             ConversationMessage[]
  conversationTurns   ConversationTurn[]
  decisions           Decision[]
  assumptions         Assumption[]
  questions           OpenQuestion[]
  contradictions      Contradiction[]
  requirements        Requirement[]
  references           Reference[]
  toolRuns             ToolRun[]
  agentRuns            AgentRun[]
  artifacts            Artifact[]
  packageJobs          PackageJob[]
  designGenerationJobs DesignGenerationJob[]
  revisions            ProjectStateRevision[]
  draftGenerations     DraftGeneration[]
  work                 ProjectWork?
  goals                Goal[]
  milestones           Milestone[]
  tasks                Task[]
  capturedIdeas        CapturedIdea[]
  @@index([updatedAt])
}

model ConversationTurn {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestId       String
  text            String
  status          String   @default("RUNNING")
  attempt         Int      @default(1)
  projectVersion  Int?
  responsePayload String?
  errorSummary    String?
  providerCalls   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  messages        ConversationMessage[]

  @@unique([projectId, requestId])
  @@index([projectId, createdAt])
  @@index([projectId, status, updatedAt])
}

model PackageJob {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectVersion Int
  status         String   @default("QUEUED")
  stage          String   @default("PREPARING_PRODUCT")
  completedStages String  @default("[]")
  progress      String   @default("{}")
  errorSummary  String?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  heartbeatAt   DateTime?

  @@index([projectId, createdAt])
  @@index([status, heartbeatAt])
}

model DesignGenerationJob {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectVersion Int
  status         String   @default("QUEUED")
  stage          String   @default("DESIGN_ARCHITECTURE")
  progress       String   @default("{}")
  errorSummary   String?
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  heartbeatAt    DateTime?

  @@index([projectId, createdAt])
  @@index([status, heartbeatAt])
}

model ConversationMessage {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role               String
  content            String
  metadata           String?
  conversationTurnId String?
  conversationTurn   ConversationTurn? @relation(fields: [conversationTurnId], references: [id], onDelete: SetNull)
  requestId          String?
  createdAt          DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, conversationTurnId])
  @@index([projectId, requestId])
}

model Decision {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic       String
  decision    String
  reason      String?
  source      String
  status      String   @default("ACCEPTED")
  affects     String   @default("[]")
  provenance  String   @default("USER")
  supersedes  String?
  createdAt   DateTime @default(now())

  @@index([projectId, topic])
}

model Assumption {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statement      String
  confidence     String
  impact         String
  source         String
  validationPlan String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([projectId, confidence])
}

model OpenQuestion {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text           String
  category       String
  priority       Int      @default(5)
  requirementIds String   @default("[]")
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  answeredAt     DateTime?

  @@index([projectId, status, priority])
}

model Contradiction {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severity           String
  explanation        String
  conflictingFields  String   @default("[]")
  recommendedFix     String
  status             String   @default("OPEN")
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?

  @@index([projectId, status, severity])
}

model Requirement {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  status      String
  priority    Int      @default(5)
  riskWeight  Int      @default(5)
  confidence  Int      @default(0)
  source      String   @default("SYSTEM")
  evidence    String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, category, status])
}

model Reference {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  url         String
  status      String   @default("PENDING")
  metadata    String?
  untrusted   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, createdAt])
}

model ToolRun {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolName     String
  status       String   @default("QUEUED")
  inputSummary String?
  outputSummary String?
  failureReason String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model AgentRun {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal          String
  status        String   @default("QUEUED")
  actionType    String?
  failureReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
}

model Artifact {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draftGenerationId String?
  draftGeneration  DraftGeneration? @relation(fields: [draftGenerationId], references: [id], onDelete: SetNull)
  type             String
  status           String          @default("DRAFT")
  content          String
  version          Int             @default(1)
  canonicalVersion Int?
  generatedAt      DateTime        @default(now())

  @@unique([projectId, type, version])
  @@index([projectId, type, generatedAt])
  @@index([draftGenerationId, type])
}

model DraftGeneration {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canonicalVersion  Int
  generationNumber  Int
  status            String   @default("RUNNING")
  sourceGenerationId String?
  sourceGeneration  DraftGeneration? @relation("DraftGenerationSource", fields: [sourceGenerationId], references: [id], onDelete: SetNull)
  derivedGenerations DraftGeneration[] @relation("DraftGenerationSource")
  composerInput     String
  composerMetadata  String?
  errorSummary      String?
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  artifacts         Artifact[]

  @@unique([projectId, generationNumber])
  @@index([projectId, canonicalVersion, status, generationNumber])
}

model ProjectStateRevision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int
  state     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ProviderProfile {
  id          String   @id @default(cuid())
  name        String
  provider    String
  baseUrl     String?
  model       String?
  credentialRef String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, updatedAt])
}

// Living workspace captures immutable notes and keeps conversational approvals durable.
model CapturedIdea {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId        String
  requestId      String
  originalText   String
  @@unique([workspaceId, ownerId, requestId])
  createdAt      DateTime @default(now())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         String   @default("INBOX")
  conversionType String?
  conversionId   String?
  @@index([workspaceId, status, createdAt])
  @@index([projectId, createdAt])
}

model RockThread {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    RockMessage[]
  turns       RockTurn[]
  @@index([workspaceId, ownerId, updatedAt])
}

model RockMessage {
  id        String @id @default(cuid())
  threadId  String
  thread    RockThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
  turn      RockTurn? @relation("TurnUserMessage")
  turnId    String? @unique
  assistantTurn RockTurn? @relation("TurnAssistantMessage")
  @@index([threadId, createdAt])
}

model RockTurn {
  id                 String @id @default(cuid())
  threadId           String
  thread             RockThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userMessageId      String @unique
  userMessage        RockMessage @relation("TurnUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  requestId          String @unique
  status             String @default("QUEUED")
  executorId         String
  input              String
  externalId         String?
  leaseUntil         DateTime?
  errorSummary       String?
  retryCount         Int @default(0)
  assistantMessage   RockMessage? @relation("TurnAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  assistantMessageId String? @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  proposals          RockProposal[]
  @@unique([threadId, requestId])
  @@index([threadId, createdAt])
  @@index([status, leaseUntil])
}

model RockProposal {
  id         String @id @default(cuid())
  turnId     String
  turn       RockTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  position   Int
  type       String
  payload    String
  status     String @default("PENDING")
  result     String?
  decisionAt DateTime?
  @@unique([turnId, position])
  @@index([turnId, status])
}

// Work OS is additive: discovery Project columns and AgentRun semantics stay unchanged.
model Workspace {
  id        String @id
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  projects  ProjectWork[]
  activity  ActivityEvent[]
  ideas CapturedIdea[]
  threads RockThread[]
}

model ProjectWork {
  projectId   String @id
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  status      String @default("ACTIVE")
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([workspaceId, status])
}

model Goal {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title     String
  status    String @default("ACTIVE")
  createdAt DateTime @default(now())
  milestones Milestone[]
  tasks      Task[]
  @@index([projectId, status])
}

model Milestone {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  goalId    String?
  goal      Goal? @relation(fields: [goalId], references: [id], onDelete: Restrict)
  title     String
  status    String @default("OPEN")
  dueAt     DateTime?
  createdAt DateTime @default(now())
  tasks     Task[]
  @@index([projectId, dueAt])
}

model Task {
  id                 String @id @default(cuid())
  projectId          String
  project            Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  goalId             String?
  goal               Goal? @relation(fields: [goalId], references: [id], onDelete: Restrict)
  milestoneId        String?
  milestone          Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  title              String
  description        String?
  acceptanceCriteria String
  status             String @default("TODO")
  priority           String @default("NORMAL")
  dueAt              DateTime?
  plannedDate        DateTime?
  activeExecutionId  String? @unique
  acceptedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assignment         TaskAssignment?
  executions         AgentExecution[]
  @@index([projectId, status])
  @@index([status, dueAt])
  @@index([plannedDate, priority])
}

model TaskAssignment {
  id         String @id @default(cuid())
  taskId     String @unique
  task       Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  kind       String
  humanId    String?
  executorId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AgentExecution {
  id             String @id
  taskId         String
  task           Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  executorId     String
  requestId      String
  input          String
  status         String @default("QUEUED")
  externalId     String?
  output         String?
  errorSummary   String?
  retryCount     Int @default(0)
  leaseUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  evidence       Evidence[]
  approval       Approval?
  @@unique([taskId, requestId])
  @@unique([executorId, externalId])
  @@index([status, createdAt])
}

model Approval {
  id          String @id @default(cuid())
  executionId String @unique
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  decision    String
  reviewerId  String
  comment     String?
  createdAt   DateTime @default(now())
}

model Evidence {
  id          String @id @default(cuid())
  executionId String
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  key         String
  kind        String
  title       String
  content     String
  uri         String?
  createdAt   DateTime @default(now())
  @@unique([executionId, key])
}

model ActivityEvent {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId   String?
  taskId      String?
  executionId String?
  actorId     String
  type        String
  detail      String
  createdAt   DateTime @default(now())
  @@index([workspaceId, createdAt])
}
