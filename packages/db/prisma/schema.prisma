generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  canonicalState String   @default("{}")
  version        Int      @default(1)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       ConversationMessage[]
  decisions      Decision[]
  assumptions    Assumption[]
  questions      OpenQuestion[]
  contradictions Contradiction[]
  requirements   Requirement[]
  references     Reference[]
  toolRuns       ToolRun[]
  agentRuns      AgentRun[]
  artifacts      Artifact[]
  revisions      ProjectStateRevision[]

  @@index([updatedAt])
}

model ConversationMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Decision {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic       String
  decision    String
  reason      String?
  source      String
  status      String   @default("ACCEPTED")
  affects     String   @default("[]")
  provenance  String   @default("USER")
  supersedes  String?
  createdAt   DateTime @default(now())

  @@index([projectId, topic])
}

model Assumption {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statement      String
  confidence     String
  impact         String
  source         String
  validationPlan String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([projectId, confidence])
}

model OpenQuestion {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text           String
  category       String
  priority       Int      @default(5)
  requirementIds String   @default("[]")
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  answeredAt     DateTime?

  @@index([projectId, status, priority])
}

model Contradiction {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severity           String
  explanation        String
  conflictingFields  String   @default("[]")
  recommendedFix     String
  status             String   @default("OPEN")
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?

  @@index([projectId, status, severity])
}

model Requirement {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  status      String
  priority    Int      @default(5)
  riskWeight  Int      @default(5)
  confidence  Int      @default(0)
  source      String   @default("SYSTEM")
  evidence    String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, category, status])
}

model Reference {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  url         String
  status      String   @default("PENDING")
  metadata    String?
  untrusted   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, createdAt])
}

model ToolRun {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolName     String
  status       String   @default("QUEUED")
  inputSummary String?
  outputSummary String?
  failureReason String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model AgentRun {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal          String
  status        String   @default("QUEUED")
  actionType    String?
  failureReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
}

model Artifact {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  status      String   @default("DRAFT")
  content     String
  version     Int      @default(1)
  generatedAt DateTime @default(now())

  @@unique([projectId, type, version])
  @@index([projectId, type, generatedAt])
}

model ProjectStateRevision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int
  state     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ProviderProfile {
  id          String   @id @default(cuid())
  name        String
  provider    String
  baseUrl     String?
  model       String?
  credentialRef String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, updatedAt])
}
