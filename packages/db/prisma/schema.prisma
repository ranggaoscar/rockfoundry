generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Auth (Better Auth) - Core Identity
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   // For future workspace logic or admin

  sessions      Session[]
  accounts      Account[]
  
  projects      ProjectMember[]
  subscriptions Subscription[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ------------------------------------------------------
// Application Domain - Projects & Content
// ------------------------------------------------------

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?  // The rough idea
  
  // JSONB source of truth
  canonicalState Json     @default("{}")
  version        Int      @default(1)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  members        ProjectMember[]
  documents      GeneratedDocument[]
  references     Reference[]
  revisions      ProjectStateRevision[]
  aiRuns         AiRun[]
}

model ProjectStateRevision {
  id        String   @id @default(cuid())
  version   Int
  state     Json
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model AiRun {
  id            String   @id @default(cuid())
  taskType      String   // initial_idea_extraction
  provider      String   // e.g., openai, anthropic
  model         String   
  promptVersion String
  inputHash     String?
  status        String   @default("queued") // queued, running, completed, failed
  
  startedAt     DateTime?
  completedAt   DateTime?
  
  tokenUsage    Int      @default(0)
  latencyMs     Int?
  failureReason String?
  retryCount    Int      @default(0)

  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  events        AiRunEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AiRunEvent {
  id        String   @id @default(cuid())
  runId     String
  run       AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  
  type      String   // request_started, response_received, error
  payload   Json?
  
  createdAt DateTime @default(now())
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      String   @default("owner") // owner, editor, viewer

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
}

model Reference {
  id        String   @id @default(cuid())
  type      String   // URL, GITHUB_REPO
  url       String
  status    String   @default("pending") // pending, analyzed, failed
  
  // JSONB result from background extraction
  metadata  Json?
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeneratedDocument {
  id        String   @id @default(cuid())
  type      String   // ZIP_EXPORT, AGENT_INSTRUCTIONS, PRD
  status    String   @default("pending") // pending, complete, failed
  
  storageKey String? // S3/MinIO key for download
  expiresAt  DateTime?
  
  // Point-in-time state of the project when exported
  snapshot  Json?

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// Billing & Operations
// ------------------------------------------------------

model Subscription {
  id        String   @id @default(cuid())
  plan      String   // cloud_starter, community
  status    String   @default("active") // active, expired, canceled
  
  startsAt  DateTime @default(now())
  expiresAt DateTime?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id             String       @id @default(cuid())
  provider       String       // sumopod
  providerRef    String?      // external invoice ID
  amount         Int          // usually 49000
  currency       String       @default("IDR")
  status         String       @default("pending") // pending, paid, failed, expired
  
  // Webhook payloads and provider-specific details
  metadata       Json?

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model UsageEvent {
  id          String   @id @default(cuid())
  userId      String   // Kept flat for easy aggregation
  type        String   // ai_generation, ai_analysis
  costTokens  Int      @default(0)
  
  // Router metadata (latency, provider, model)
  metadata    Json?

  createdAt   DateTime @default(now())
}

model BackgroundJob {
  id          String   @id @default(cuid())
  type        String   // extract_idea, analyze_repo, render_zip
  status      String   @default("queued") // queued, processing, completed, failed
  
  payload     Json?
  result      Json?
  error       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}