  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "module": "node16",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "target": "ES2022"
  },
  "include": ["index.ts", "paths.ts", "prisma.config.ts"]
}
