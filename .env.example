# RockFoundry local environment

# Optional override. Default is an OS-aware SQLite file under the RockFoundry app-data directory.
ROCKFOUNDRY_DATABASE_URL="file:./rockfoundry.db"

# Shared public demo mode: provider configuration is server-managed and browser mutations/testing are disabled.
# Keep false for normal local BYOK installs.
ROCKFOUNDRY_PUBLIC_DEMO="false"

# Optional self-hosted/public search adapter. Leave unset to keep web research unavailable.
# ROCKFOUNDRY_SEARCH_PROVIDER="searxng"
# ROCKFOUNDRY_SEARCH_BASE_URL="https://search.example.org/search"
# ROCKFOUNDRY_SEARCH_API_KEY=""

# mock is deterministic and needs no key. Use openai-compatible for OpenAI, OpenRouter, 9Router, Ollama-compatible, or a custom endpoint.
AI_PROVIDER_MODE="mock"
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="gpt-4o-mini"

NODE_ENV="development"
