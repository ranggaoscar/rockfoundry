# ╔═══════════════════════════════════════════════╗
# ║  RockFoundry — Environment Variables           ║
# ║  Copy this file to .env and fill in values     ║
# ╚══════════════════════════════════════════════════╝

# ── Database ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/rockfoundry?schema=public"

# ── Authentication (Better Auth) ──────────────────
BETTER_AUTH_SECRET="change-me-to-a-random-64-char-string-at-least"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ── AI Provider (9Router) ─────────────────────────
# Set to "9router" to use real AI, keep "mock" for development/testing
AI_PROVIDER_MODE="mock"
NINE_ROUTER_BASE_URL="https://api.9router.com"
NINE_ROUTER_API_KEY=""
NINE_ROUTER_DEFAULT_MODEL="gpt-4o"
NINE_ROUTER_CHEAP_MODEL="gpt-4o-mini"
NINE_ROUTER_STRONG_MODEL="gpt-4o"

# ── Storage ───────────────────────────────────────
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./data/exports"

# ── Payment ───────────────────────────────────────
PAYMENT_PROVIDER="none"

# ── Environment ───────────────────────────────────
NODE_ENV="development"
